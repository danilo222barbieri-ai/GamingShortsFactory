# URL pubblico HTTPS finale del sito, con slash finale consigliato.
GSF_PUBLIC_APP_URL=https://tuo-dominio.example/

# Sessioni anonime: 2 ore di inattivita prima della pulizia automatica.
GSF_SESSION_TTL_SECONDS=7200

# YouTube: usa UNA delle due opzioni. La credenziale deve essere di tipo Web application.
# GSF_YOUTUBE_CLIENT_SECRET_FILE=/run/secrets/youtube_client_secret.json
# GSF_YOUTUBE_CLIENT_SECRET_JSON={"web":{"client_id":"...","client_secret":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","redirect_uris":["https://tuo-dominio.example/"]}}

# TikTok developer app. Redirect URI: ${GSF_PUBLIC_APP_URL}/auth/tiktok/callback.
# GSF_TIKTOK_CLIENT_KEY=...
# GSF_TIKTOK_CLIENT_SECRET=...

# Instagram Graph API: opzionale, per un account professionale gia configurato lato server.
# GSF_INSTAGRAM_USER_ID=...
# GSF_INSTAGRAM_ACCESS_TOKEN=...

# Meta Facebook Login / Pages (reuse existing GSF_ names; secrets only in Railway).
# GSF_META_APP_ID=
# GSF_META_APP_SECRET=
# GSF_META_GRAPH_VERSION=v24.0
# Facebook redirect: ${GSF_PUBLIC_APP_URL}/auth/facebook/callback
# Instagram Business Login (professional accounts).
# GSF_INSTAGRAM_APP_ID=
# GSF_INSTAGRAM_APP_SECRET=
# Instagram redirect: ${GSF_PUBLIC_APP_URL}/auth/instagram/callback
# Meta public callbacks: /auth/meta/deauthorize and /auth/meta/data-deletion
# Deletion status: /auth/meta/data-deletion/status?code=<confirmation_code>

# Twitch confidential web application. Exact redirect: ${GSF_PUBLIC_APP_URL}/auth/twitch/callback
# GSF_TWITCH_CLIENT_ID=
# GSF_TWITCH_CLIENT_SECRET=
# Scope required by official own-channel clip downloads: channel:manage:clips
# VODs: metadata only; official Get Videos does not expose a downloadable file.
