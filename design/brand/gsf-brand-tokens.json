{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Gaming Shorts Factory Brand v1",
  "color": {
    "brand": {
      "primary": {
        "$type": "color",
        "$value": "#27AEF3"
      },
      "primaryLight": {
        "$type": "color",
        "$value": "#79D2FF"
      },
      "cyan": {
        "$type": "color",
        "$value": "#53E0EA"
      }
    },
    "product": {
      "ai": {
        "$type": "color",
        "$value": "#9D82FF"
      },
      "editor": {
        "$type": "color",
        "$value": "#27AEF3"
      },
      "short": {
        "$type": "color",
        "$value": "#5ED6A0"
      }
    },
    "feedback": {
      "warning": {
        "$type": "color",
        "$value": "#FFD84D"
      },
      "danger": {
        "$type": "color",
        "$value": "#FF6673"
      }
    },
    "neutral": {
      "backgroundSoft": {
        "$type": "color",
        "$value": "#EEF9FF"
      },
      "surface": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "line": {
        "$type": "color",
        "$value": "#D9EFFB"
      },
      "ink": {
        "$type": "color",
        "$value": "#10283D"
      },
      "muted": {
        "$type": "color",
        "$value": "#6D8497"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "$value": [
        "Avenir Next",
        "SF Pro Display",
        "SF Pro Text",
        "-apple-system",
        "BlinkMacSystemFont",
        "Segoe UI",
        "sans-serif"
      ]
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 13,
        "unit": "px"
      }
    },
    "md": {
      "$type": "dimension",
      "$value": {
        "value": 18,
        "unit": "px"
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": {
        "value": 28,
        "unit": "px"
      }
    },
    "pill": {
      "$type": "dimension",
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  }
}