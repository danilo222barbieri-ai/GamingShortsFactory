FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN python -m pip install --upgrade pip && \
    python -m pip install streamlit==1.49.1

COPY web/demo_app.py /app/demo_app.py

EXPOSE 8080

CMD ["sh","-c","python -m streamlit run /app/demo_app.py --server.address=0.0.0.0 --server.port=${PORT:-8080} --server.headless=true"]
