map $cookie_gsf_sid $gsf_session_cookie {
    "~^[A-Za-z0-9_-]{1,80}$" $cookie_gsf_sid;
    default                     $request_id;
}

server {
    listen ${PORT};
    server_name _;

    client_max_body_size 4096m;
    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;

    # V105.7: Google AdSense ownership / authorized seller declaration.
    # The file exists only when GSF_ADSENSE_CLIENT contains a valid ca-pub id.
    location = /ads.txt {
        alias /tmp/gsf-ads.txt;
        default_type text/plain;
        add_header Cache-Control "public, max-age=300";
    }

    # TikTok URL-prefix ownership verification.
    location = /tiktokAvCxVH6S4w3BElUktwlT3dRIBn1ECcZv.txt {
        alias /app/web/tiktokAvCxVH6S4w3BElUktwlT3dRIBn1ECcZv.txt;
        default_type text/plain;
        add_header Cache-Control "no-store";
    }

    # V104.2: public legal pages used by social-provider app reviews.
    location = /privacy {
        alias /app/web/legal/privacy.html;
        default_type text/html;
        add_header Cache-Control "public, max-age=300";
    }

    location = /terms {
        alias /app/web/legal/terms.html;
        default_type text/html;
        add_header Cache-Control "public, max-age=300";
    }

    # Official Gaming Shorts Factory app identity.
    location = /app-icon.png {
        alias /app/web/app_icons/app-icon.png;
        default_type image/png;
        add_header Cache-Control "no-store";
    }

    location = /app-icon-192.png {
        alias /app/web/app_icons/app-icon-192.png;
        default_type image/png;
        add_header Cache-Control "public, max-age=86400";
    }

    location = /app-icon-512.png {
        alias /app/web/app_icons/app-icon-512.png;
        default_type image/png;
        add_header Cache-Control "public, max-age=86400";
    }

    location = /favicon.ico {
        alias /app/web/app_icons/app-icon.png;
        default_type image/png;
        add_header Cache-Control "no-store";
    }

    # iOS/iPadOS Home Screen icon discovery paths.
    location = /apple-touch-icon.png {
        alias /app/web/app_icons/apple-touch-icon.png;
        default_type image/png;
        add_header Cache-Control "no-store";
    }

    location = /apple-touch-icon-precomposed.png {
        alias /app/web/app_icons/apple-touch-icon.png;
        default_type image/png;
        add_header Cache-Control "no-store";
    }

    location = /apple-touch-icon-180x180.png {
        alias /app/web/app_icons/apple-touch-icon.png;
        default_type image/png;
        add_header Cache-Control "no-store";
    }

    location = /apple-touch-icon-152x152.png {
        alias /app/web/app_icons/apple-touch-icon.png;
        default_type image/png;
        add_header Cache-Control "no-store";
    }

    location = /manifest.webmanifest {
        proxy_pass http://127.0.0.1:8502/manifest.webmanifest;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location = /gsf-sw.js {
        proxy_pass http://127.0.0.1:8502/gsf-sw.js;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Service-Worker-Allowed "/" always;
        add_header Cache-Control "no-cache" always;
    }

    location = /gsf-push.js {
        proxy_pass http://127.0.0.1:8502/gsf-push.js;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Cache-Control "no-cache" always;
    }

    location = /push/public-key {
        proxy_pass http://127.0.0.1:8502/push/public-key;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Cache-Control "no-store" always;
    }

    location = /push/subscribe {
        add_header Set-Cookie "gsf_sid=$gsf_session_cookie; Path=/; Max-Age=31536000; SameSite=Lax; Secure; HttpOnly" always;
        proxy_pass http://127.0.0.1:8502/push/subscribe;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-GSF-Session-ID $gsf_session_cookie;
    }

    # V84: app media URLs are /media/<session-id>/<subdir>/<file>.
    # Map that URL directly to the matching anonymous session on disk.
    location ~ "^/media/(?<gsf_media_sid>[A-Za-z0-9_-]{1,80})/(?<gsf_media_path>.+)$" {
        if ($gsf_media_sid != $gsf_session_cookie) {
            return 403;
        }

        alias /tmp/gsf-runtime/sessions/$gsf_media_sid/$gsf_media_path;
        autoindex off;
        sendfile on;
        tcp_nopush on;

        add_header Cache-Control "private, no-store";
        add_header Accept-Ranges "bytes";

        types {
            video/mp4 mp4;
            video/quicktime mov;
            video/x-matroska mkv;
            text/vtt vtt;
        }
        default_type application/octet-stream;
    }

    location = /job/status {
        add_header Set-Cookie "gsf_sid=$gsf_session_cookie; Path=/; Max-Age=31536000; SameSite=Lax; Secure; HttpOnly" always;
        proxy_pass http://127.0.0.1:8502/job/status;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-GSF-Session-ID $gsf_session_cookie;
        add_header Cache-Control "no-store" always;
    }

    location = /editor-media/current {
        add_header Set-Cookie "gsf_sid=$gsf_session_cookie; Path=/; Max-Age=31536000; SameSite=Lax; Secure; HttpOnly" always;
        proxy_pass http://127.0.0.1:8502;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-GSF-Session-ID $gsf_session_cookie;
    }

    # Private contact form. Recipient addresses stay server-side.
    location = /contact {
        add_header Set-Cookie "gsf_sid=$gsf_session_cookie; Path=/; Max-Age=31536000; SameSite=Lax; Secure; HttpOnly" always;
        proxy_pass http://127.0.0.1:8503;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-GSF-Session-ID $gsf_session_cookie;
    }

    # V158 fixed Creator Hub surface + live state API.
    location = /creator-hub-v156 {
        return 302 /creator-hub-v156/;
    }

    location /creator-hub-v156/ {
        alias /app/web/creator_hub_v156_component/;
        index index.html;
        try_files $uri $uri/ /creator-hub-v156/index.html;
        add_header Cache-Control "no-store";
    }

    location = /creator-hub/state {
        add_header Set-Cookie "gsf_sid=$gsf_session_cookie; Path=/; Max-Age=31536000; SameSite=Lax; Secure; HttpOnly" always;
        proxy_pass http://127.0.0.1:8502/creator-hub/state;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-GSF-Session-ID $gsf_session_cookie;
        add_header Cache-Control "no-store" always;
    }

    # Creator Hub: account/profile page handled by the lightweight companion server.
    location = /drafts/delete {
        add_header Set-Cookie "gsf_sid=$gsf_session_cookie; Path=/; Max-Age=31536000; SameSite=Lax; Secure; HttpOnly" always;
        proxy_pass http://127.0.0.1:8502/drafts/delete$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-GSF-Session-ID $gsf_session_cookie;
    }

    location = /drafts/resume {
        add_header Set-Cookie "gsf_sid=$gsf_session_cookie; Path=/; Max-Age=31536000; SameSite=Lax; Secure; HttpOnly" always;
        proxy_pass http://127.0.0.1:8502/drafts/resume$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-GSF-Session-ID $gsf_session_cookie;
    }

    location = /account {
        add_header Set-Cookie "gsf_sid=$gsf_session_cookie; Path=/; Max-Age=31536000; SameSite=Lax; Secure; HttpOnly" always;
        proxy_pass http://127.0.0.1:8502;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-GSF-Session-ID $gsf_session_cookie;
    }

    location /account/ {
        add_header Set-Cookie "gsf_sid=$gsf_session_cookie; Path=/; Max-Age=31536000; SameSite=Lax; Secure; HttpOnly" always;
        proxy_pass http://127.0.0.1:8502;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-GSF-Session-ID $gsf_session_cookie;
    }

    # Dedicated Instagram OAuth callback used by Meta/Instagram Business Login.
    location = /auth/instagram/callback {
        add_header Set-Cookie "gsf_sid=$gsf_session_cookie; Path=/; Max-Age=31536000; SameSite=Lax; Secure; HttpOnly" always;
        proxy_pass http://127.0.0.1:8502/social-connect/instagram/callback;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-GSF-Session-ID $gsf_session_cookie;
    }

    # V104.4: standalone social-account connection flow.
    # This bypasses Streamlit so OAuth can be completed without a loaded video.
    location = /social-connect {
        add_header Set-Cookie "gsf_sid=$gsf_session_cookie; Path=/; Max-Age=31536000; SameSite=Lax; Secure; HttpOnly" always;
        proxy_pass http://127.0.0.1:8502;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-GSF-Session-ID $gsf_session_cookie;
    }

    location /social-connect/ {
        add_header Set-Cookie "gsf_sid=$gsf_session_cookie; Path=/; Max-Age=31536000; SameSite=Lax; Secure; HttpOnly" always;
        proxy_pass http://127.0.0.1:8502;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-GSF-Session-ID $gsf_session_cookie;
    }

    # V98.9: chunked disk upload bypasses Streamlit's in-memory UploadedFile.
    location /direct-upload/ {
        add_header Set-Cookie "gsf_sid=$gsf_session_cookie; Path=/; Max-Age=31536000; SameSite=Lax; Secure; HttpOnly" always;

        proxy_pass http://127.0.0.1:8502/;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        client_body_timeout 86400s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-GSF-Session-ID $gsf_session_cookie;
    }

    # V104.4: reuse the already-registered app root as TikTok OAuth callback.
    # Only our cryptographic state prefix is diverted; ordinary "/" still goes to Streamlit.
    location = / {
        add_header Set-Cookie "gsf_sid=$gsf_session_cookie; Path=/; Max-Age=31536000; SameSite=Lax; Secure; HttpOnly" always;

        error_page 418 = @gsf_tiktok_oauth_callback;
        if ($arg_state ~ "^gsfsc_") {
            return 418;
        }

        error_page 419 = @gsf_youtube_oauth_callback;
        if ($arg_state ~ "^gsfyt_") {
            return 419;
        }

        error_page 420 = @gsf_instagram_oauth_callback;
        if ($arg_state ~ "^gsfig_") {
            return 420;
        }

        error_page 421 = @gsf_account_google_callback;
        if ($arg_state ~ "^gsfacg_") {
            return 421;
        }

        error_page 422 = @gsf_account_facebook_callback;
        if ($arg_state ~ "^gsfacf_") {
            return 422;
        }

        error_page 423 = @gsf_account_tiktok_callback;
        if ($arg_state ~ "^gsfact_") {
            return 423;
        }

        proxy_pass http://127.0.0.1:8501;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_set_header Accept-Encoding "";
        sub_filter_once on;
        sub_filter '</head>' '<link rel="icon" type="image/png" href="/app-icon.png?v=4"><link rel="shortcut icon" href="/favicon.ico?v=4"><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-180x180.png?v=4"><link rel="apple-touch-icon" href="/apple-touch-icon.png?v=4"><link rel="manifest" href="/manifest.webmanifest?v=4"><script defer src="/gsf-push.js?v=3"></script><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-title" content="Gaming Shorts Factory"><meta name="apple-mobile-web-app-status-bar-style" content="default"><meta name="mobile-web-app-capable" content="yes"><meta name="theme-color" content="#a9dcff"></head>';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-GSF-Session-ID $gsf_session_cookie;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location @gsf_tiktok_oauth_callback {
        rewrite ^ /social-connect/tiktok/callback break;
        add_header Set-Cookie "gsf_sid=$gsf_session_cookie; Path=/; Max-Age=31536000; SameSite=Lax; Secure; HttpOnly" always;
        proxy_pass http://127.0.0.1:8502;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-GSF-Session-ID $gsf_session_cookie;
    }

    location @gsf_youtube_oauth_callback {
        rewrite ^ /social-connect/youtube/callback break;
        add_header Set-Cookie "gsf_sid=$gsf_session_cookie; Path=/; Max-Age=31536000; SameSite=Lax; Secure; HttpOnly" always;
        proxy_pass http://127.0.0.1:8502;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-GSF-Session-ID $gsf_session_cookie;
    }

    location @gsf_instagram_oauth_callback {
        rewrite ^ /social-connect/instagram/callback break;
        add_header Set-Cookie "gsf_sid=$gsf_session_cookie; Path=/; Max-Age=31536000; SameSite=Lax; Secure; HttpOnly" always;
        proxy_pass http://127.0.0.1:8502;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-GSF-Session-ID $gsf_session_cookie;
    }

    location @gsf_account_google_callback {
        rewrite ^ /account/google/callback break;
        add_header Set-Cookie "gsf_sid=$gsf_session_cookie; Path=/; Max-Age=31536000; SameSite=Lax; Secure; HttpOnly" always;
        proxy_pass http://127.0.0.1:8502;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-GSF-Session-ID $gsf_session_cookie;
    }

    location @gsf_account_facebook_callback {
        rewrite ^ /account/facebook/callback break;
        add_header Set-Cookie "gsf_sid=$gsf_session_cookie; Path=/; Max-Age=31536000; SameSite=Lax; Secure; HttpOnly" always;
        proxy_pass http://127.0.0.1:8502;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-GSF-Session-ID $gsf_session_cookie;
    }

    location @gsf_account_tiktok_callback {
        rewrite ^ /account/tiktok/callback break;
        add_header Set-Cookie "gsf_sid=$gsf_session_cookie; Path=/; Max-Age=31536000; SameSite=Lax; Secure; HttpOnly" always;
        proxy_pass http://127.0.0.1:8502;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-GSF-Session-ID $gsf_session_cookie;
    }

    location / {
        add_header Set-Cookie "gsf_sid=$gsf_session_cookie; Path=/; Max-Age=31536000; SameSite=Lax; Secure; HttpOnly" always;

        proxy_pass http://127.0.0.1:8501;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_set_header Accept-Encoding "";
        sub_filter_once on;
        sub_filter '</head>' '<link rel="icon" type="image/png" href="/app-icon.png?v=4"><link rel="shortcut icon" href="/favicon.ico?v=4"><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-180x180.png?v=4"><link rel="apple-touch-icon" href="/apple-touch-icon.png?v=4"><link rel="manifest" href="/manifest.webmanifest?v=4"><script defer src="/gsf-push.js?v=3"></script><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-title" content="Gaming Shorts Factory"><meta name="apple-mobile-web-app-status-bar-style" content="default"><meta name="mobile-web-app-capable" content="yes"><meta name="theme-color" content="#a9dcff"></head>';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-GSF-Session-ID $gsf_session_cookie;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
