# GSF_SECURITY_V410 — edge hardening, abuse control and browser policy
# GSF_SECURITY_V410_EDGE_ID — Railway publishes the remote client as X-Real-IP.
map $http_x_real_ip $gsf_client_key {
    "~^[0-9A-Fa-f:.]{2,45}$" $http_x_real_ip;
    default $binary_remote_addr;
}
limit_req_zone $gsf_client_key zone=gsf_api_v410:10m rate=20r/s;
limit_req_zone $gsf_client_key zone=gsf_upload_v410:10m rate=20r/s;
limit_conn_zone $gsf_client_key zone=gsf_conn_v410:10m;

map $cookie_gsf_sid $gsf_session_cookie {
    "~^[A-Za-z0-9_-]{1,80}$" $cookie_gsf_sid;
    default                     $request_id;
}

# V411_STABLE_SESSION_COOKIE
# Keep one browser session id across sequential requests. When no cookie exists,
# use the request id for this response; once Set-Cookie is received the browser
# sends that same id back and all protected companion routes reuse it.

map $http_sec_ch_ua_mobile $gsf_ch_mobile {
    default 0;
    "~*\\?1" 1;
}

# GSF_MOBILE_ONLY_V419: GSF is a phone app. Tablets and desktop browsers get the
# mobile-only page (/__gsf_mobile_gate). Regexes are evaluated in order.
map $http_user_agent $gsf_ua_mobile {
    default 0;
    "~*(ipad|tablet|kindle|silk/|playbook)" 0;
    "~*(iphone|ipod|android.+mobile|windows phone|iemobile|opera mini|mobile safari|[ ;/]mobile[ ;/])" 1;
}

map "$gsf_ch_mobile:$gsf_ua_mobile" $gsf_mobile_client {
    default 0;
    "1:0" 1;
    "0:1" 1;
    "1:1" 1;
}

