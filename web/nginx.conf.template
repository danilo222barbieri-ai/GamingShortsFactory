map $cookie_gsf_sid $gsf_session_cookie {
    ~^[A-Za-z0-9_-]{1,80}$ $cookie_gsf_sid;
    default                  $request_id;
}

server {
    listen ${PORT};
    server_name _;

    client_max_body_size 4096m;
    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;

    # V82: serve direttamente i media della sessione anonima dal filesystem.
    # Evita i 502 del piccolo server Python /media e, su Safari/iPadOS,
    # impedisce che la pagina HTML d'errore venga salvata come ".mp4.html".
    location /media/ {
        alias /tmp/gsf-runtime/sessions/$gsf_session_cookie/media/;
        autoindex off;
        sendfile on;
        tcp_nopush on;
        add_header Cache-Control "private, no-store";
        add_header Accept-Ranges "bytes";
        types {
            video/mp4 mp4;
            video/quicktime mov;
            video/x-matroska mkv;
            text/vtt vtt;
        }
        default_type application/octet-stream;
    }

    location / {
        add_header Set-Cookie "gsf_sid=$gsf_session_cookie; Path=/; Max-Age=21600; SameSite=Lax; Secure; HttpOnly" always;

        proxy_pass http://127.0.0.1:8501;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-GSF-Session-ID $gsf_session_cookie;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
