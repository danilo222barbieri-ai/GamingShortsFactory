FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    GSF_AI_APP_PATH=/app/GamingShortsFactory_V99_FINAL_ARCH.py \
    GSF_WORKER_SCAN_SLOTS=1 \
    GSF_WORKER_DOWNLOAD_CONCURRENCY=8 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY web/requirements-worker.txt /app/requirements-worker.txt
RUN python -m pip install --upgrade pip && python -m pip install -r /app/requirements-worker.txt

COPY gsf_core /app/gsf_core
COPY gsf_project_state.py /app/
COPY web /app/web
COPY web/ffmpeg_lowmem.py /usr/local/bin/ffmpeg
# Same runtime path as before (Railway sets GSF_AI_APP_PATH to it).
COPY web/gsf_worker_app.py /app/GamingShortsFactory_V99_FINAL_ARCH.py

# GSF canonical worker: web/gsf_worker_app.py and web/ai_worker_server.py are the
# files the worker runs, committed as-is. No V77 payload, no apply_v78..v99 chain,
# no build-time patch of ai_worker_server.py (V401 is already in the file).
RUN chmod +x /usr/local/bin/ffmpeg && \
    python /app/web/test_v114_semantic_video.py && \
    python /app/web/test_v124_ai_core.py && \
    python /app/web/test_v129_auto_highlights.py && \
    python /app/web/test_v402_game_brain_auto_highlights.py && \
    python -m py_compile /app/web/job_state_v401.py && \
    python -m py_compile /app/web/semantic_video_v114.py && \
    python -m py_compile /app/web/ai_director_v124.py && \
    python -m py_compile /app/web/quality_control_v124.py && \
    python -m py_compile /app/web/guardian_intelligence_v124.py && \
    python -m py_compile /app/web/highlight_fusion_v402.py && \
    python -m py_compile /app/web/auto_highlights/engine_v129.py && \
    python -m py_compile /app/web/one_click_v130.py && \
    python -m py_compile /app/web/ai_worker_server.py /app/GamingShortsFactory_V99_FINAL_ARCH.py

EXPOSE 8600
CMD ["python","/app/web/ai_worker_server.py"]

# V108 Game Vision Event Map worker
